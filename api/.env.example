DATABASE_URL=postgresql://user:password@localhost:5432/cargaback
NODE_ENV=production
PORT=3001
JWT_SECRET=cambia_esto_por_un_secreto_seguro
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
MP_CLIENT_ID=tu_client_id_de_mp
MP_CLIENT_SECRET=tu_client_secret_de_mp
MP_REDIRECT_URI=https://tu-api.railway.app/auth/mp/callback
INTERNAL_SECRET=secreto_compartido_con_nextjs
FRONTEND_URL=https://tu-proyecto.vercel.app


# Google Cloud Vision API — para verificación automática de DNI
# Obtené la API key en: console.cloud.google.com > APIs > Cloud Vision API > Credenciales
GOOGLE_VISION_API_KEY=tu_google_vision_api_key

# EmailJS (https://emailjs.com) — Account > API Keys
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx

# Veriff — verificación de identidad (KYC + liveness)
# Dejar VERIFF_PROVIDER sin setear (o != 'veriff') para usar el mock local
# En producción con cuenta real: setear provider=veriff + api key + shared secret
# Obtené las credenciales en el Veriff Station: Integrations > API keys
# Configurá el webhook de decision en: Integrations > Webhooks
#   URL: https://<tu-api>/verification/webhook
VERIFF_PROVIDER=mock
VERIFF_API_KEY=
VERIFF_API_SECRET=

# Detección de precios inusuales en cargas — alertas para el admin
# PRICE_ALERT_LOW_PCT: si el precio es menor a este % del promedio de mercado, se marca como sospechosa
# PRICE_ALERT_HIGH_PCT: si el precio supera este % del promedio de mercado, se marca como sospechosa
# Requiere al menos 5 cargas del mismo tipo como historial para activarse
PRICE_ALERT_LOW_PCT=40
PRICE_ALERT_HIGH_PCT=250
